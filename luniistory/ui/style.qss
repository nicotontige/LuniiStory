QWidget {
    background: #faf7f2;
    color: #2d2a26;
    font-size: 13px;
}

/* Les libellés héritent sinon du fond de QWidget et découpent des rectangles
   clairs par-dessus l'entête et les cartes. */
QLabel, QCheckBox {
    background: transparent;
}

QCheckBox {
    spacing: 8px;
}

#header {
    background: #02D3BE;
    color: #0D2B28;
}

#header QLabel {
    color: #0D2B28;
}

/* The header combo boxes deliberately keep the plain light styling. Painting
   them dark means white text, which the drop-down list inherits and then draws
   on its own white background — the items vanish. */
QComboBox QAbstractItemView {
    background: #ffffff;
    color: #2d2a26;
    border: 1px solid #d8d1c7;
    selection-background-color: #02D3BE;
    selection-color: #0D2B28;
}

#appTitle {
    font-size: 19px;
    font-weight: 600;
}

#deviceStatus {
    color: #0D4B44;
}

QPushButton {
    background: #ffffff;
    border: 1px solid #d8d1c7;
    border-radius: 6px;
    padding: 6px 14px;
}

QPushButton:hover {
    border-color: #0D2B28;
}

QPushButton:disabled {
    color: #a8a29a;
    background: #f0ece6;
}

QPushButton#primary {
    background: #02D3BE;
    border: none;
    color: #0D2B28;
    font-weight: 600;
    padding: 9px 20px;
}

QPushButton#primary:hover {
    background: #2ADFCC;
}

QPushButton#primary:disabled {
    background: #BDEBE5;
    color: #6F938E;
}

QLineEdit, QComboBox {
    background: #ffffff;
    border: 1px solid #d8d1c7;
    border-radius: 6px;
    padding: 6px 10px;
    /* Without a floor, descenders get clipped by the border. */
    min-height: 20px;
}

QTabBar::tab {
    background: transparent;
    padding: 8px 16px;
    border-bottom: 2px solid transparent;
}

QTabBar::tab:selected {
    border-bottom: 2px solid #02D3BE;
    font-weight: 600;
}

QTabWidget::pane {
    border: none;
}

QListWidget {
    background: #faf7f2;
    border: none;
}

#storyCard {
    background: #ffffff;
    border: 1px solid #ebe5dc;
    border-radius: 10px;
}

#storyCard[state="installed"] {
    background: #f3f1ed;
}

#storyCard[state="done"] {
    border-color: #4a9d5f;
}

#storyCard[state="failed"] {
    border-color: #c0483c;
}

#thumbnail {
    background: #ebe5dc;
    border: 1px solid #e3ddd4;
    border-radius: 6px;
    color: #a8a29a;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #c7bfb3;
    border-radius: 4px;
    background: #ffffff;
}

QCheckBox::indicator:checked {
    background: #02D3BE;
    border-color: #02D3BE;
}

#cardTitle {
    font-size: 14px;
    font-weight: 600;
}

#cardSubtitle {
    color: #7d766c;
    font-size: 12px;
}

#cardDescription {
    color: #5d574f;
    font-size: 12px;
}

#cardState {
    color: #7d766c;
    font-size: 12px;
}

#footer {
    background: #f2eee8;
    border-top: 1px solid #e3ddd4;
}

QProgressBar {
    background: #e3ddd4;
    border: none;
    border-radius: 5px;
    height: 10px;
    text-align: center;
}

QProgressBar::chunk {
    background: #02D3BE;
    border-radius: 5px;
}

QPlainTextEdit {
    background: #ffffff;
    border: 1px solid #e3ddd4;
    border-radius: 6px;
    font-family: "Menlo", "Consolas", monospace;
    font-size: 11px;
}

#dialogHint {
    color: #5d574f;
    font-size: 12px;
}

#dialogError {
    color: #c0483c;
    font-size: 12px;
}

#feedRow {
    background: #ffffff;
    border: 1px solid #ebe5dc;
    border-radius: 10px;
}

#feedAds {
    color: #b0742a;
    font-size: 12px;
}

#devicePanel {
    background: #f4f1ec;
    border-right: 1px solid #e3ddd4;
}

#panelTitle {
    font-size: 15px;
    font-weight: 600;
}

#panelSubtitle {
    color: #7d766c;
    font-size: 12px;
}

QPushButton#destructive {
    color: #c0483c;
}

QPushButton#destructive:disabled {
    color: #c7bfb3;
}

#storyCard[state="audio-only"] {
    background: #f6f4f1;
}

QSplitter::handle {
    background: #e3ddd4;
    width: 1px;
}

/* Dismiss button on a store tab. Styling it per tab state needs a descendant
   selector into the tab bar, which Qt does not apply reliably, so it keeps one
   colour and is visible whether the tab is selected or not. */
QToolButton#tabClose {
    background: transparent;
    border: none;
    color: #8e867b;
    font-size: 15px;
    padding: 0 2px;
}

QToolButton#tabClose:hover {
    color: #c0483c;
}

#emptyState {
    color: #7d766c;
    font-size: 13px;
    padding: 24px;
}

/* Check boxes inside a list are a view indicator, not a QCheckBox: styling the
   view at all makes Qt stop drawing the default one, so it needs its own rule. */
QListWidget::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #c7bfb3;
    border-radius: 4px;
    background: #ffffff;
    margin-right: 4px;
}

QListWidget::indicator:checked {
    background: #02D3BE;
    border-color: #02D3BE;
}

QListWidget::indicator:disabled {
    border-color: #e3ddd4;
    background: #f2eee8;
}

#feedGrid {
    background: #ffffff;
    border: 1px solid #ebe5dc;
    border-radius: 10px;
}

#feedGrid::item {
    border-radius: 8px;
    padding: 4px;
    color: #2d2a26;
}

#feedGrid::item:selected {
    background: #D8F7F3;
    color: #2d2a26;
}

#feedDetails {
    background: #ffffff;
    border: 1px solid #ebe5dc;
    border-radius: 10px;
}

#detailScroll {
    background: transparent;
    border: none;
}

QPushButton#update {
    background: #FFB700;
    border: none;
    color: #0D2B28;
    font-weight: 600;
    padding: 7px 16px;
}

QPushButton#update:hover {
    background: #16413C;
}
